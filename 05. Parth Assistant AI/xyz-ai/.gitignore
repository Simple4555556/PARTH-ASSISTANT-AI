# ==========================================
# PARTH ASSISTANT AI — Git Ignore Rules
# ==========================================

# Environment & Secrets (NEVER COMMIT)
.env
.env.*
.env.local
.env.development
.env.test
.env.production
!.env.example

# Node / Frontend Build Outputs
node_modules/
dist/
build/
coverage/
.next/
.turbo/
.npm/

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Cache
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# OS Metadata & Temp Files
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.temp
tmp/
temp/

# IDE & Editor Configs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Certificates, Keys & Private Cloud Credentials (NEVER COMMIT)
*.pem
*.key
*.p12
*.pfx
*.crt
*.der
credentials.json
service-account*.json
firebase-adminsdk*.json
google-credentials.json
client_secret*.json

# Databases & Backups
*.db
*.sqlite
*.sqlite3
*.dump
*.sql.gz
*.bak
