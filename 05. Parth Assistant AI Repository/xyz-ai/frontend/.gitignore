# ==========================================
# PARTH ASSISTANT AI — Frontend .gitignore
# ==========================================

# Environment & Secrets (NEVER COMMIT)
.env
.env.*
.env.local
.env.development
.env.test
.env.production
!.env.example
secrets
credentials
*.pem
*.key

# Dependencies & Build Outputs
node_modules/
dist/
dist-ssr/
build/
.vercel

# Python & ML Caches
__pycache__/
*.py[cod]
*.pkl

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & OS Metadata
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db
